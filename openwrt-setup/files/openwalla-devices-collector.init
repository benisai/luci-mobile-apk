#!/bin/sh /etc/rc.common

# Openwalla devices collector init service.
# Starts the MAC-keyed device inventory collector as a procd-managed daemon.

START=98
USE_PROCD=1
PROG="/usr/bin/openwalla-devices-collector"

is_enabled() {
	local enabled
	enabled="$(uci -q get openwalla.devices.enabled 2>/dev/null || echo 1)"
	[ "$enabled" = "1" ]
}

start_service() {
	is_enabled || return 0
	procd_open_instance
	procd_set_param command "$PROG" --daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	return 0
}

service_triggers() {
	procd_add_reload_trigger "openwalla"
	procd_add_reload_trigger "network"
	procd_add_reload_trigger "firewall"
}
